{
  "name": "@ally/engine-alfa",
  "version": "0.0.0",
  "type": "module",
  "description": "Siteimprove Alfa engine adapter for Ally",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@ally/browser": "workspace:*",
    "@ally/core": "workspace:*",
    "@siteimprove/alfa-act": "catalog:",
    "@siteimprove/alfa-dom": "catalog:",
    "@siteimprove/alfa-playwright": "catalog:",
    "@siteimprove/alfa-rules": "catalog:",
    "@siteimprove/alfa-web": "catalog:"
  },
  "devDependencies": {
    "@ally/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
