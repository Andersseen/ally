{
  "name": "@ally/wcag",
  "version": "0.0.0",
  "type": "module",
  "description": "Versioned WCAG 2.2 A/AA knowledge and Ally coverage metadata",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync": "node scripts/sync-wcag.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@ally/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
