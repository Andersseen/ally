---
import EngineRuns from '../components/EngineRuns.astro';
import FindingList from '../components/FindingList.astro';
import SampleDataNotice from '../components/SampleDataNotice.astro';
import SummaryStats from '../components/SummaryStats.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDuration, formatTimestamp } from '../lib/format.js';
import { loadAudit } from '../lib/load-audit.js';

// The report consumes an audit model. It never runs an audit itself.
const { result, isSample } = await loadAudit();
---

<BaseLayout title={`Ally audit — ${result.target.url}`}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <header class="border-b border-slate-200 pb-4">
      <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase">Ally</p>
      <p class="text-sm text-slate-600">Automated accessibility audit</p>
    </header>

    <main id="main" tabindex="-1" class="space-y-10 py-8">
      <div class="space-y-4">
        <h1 class="text-2xl font-bold sm:text-3xl">Audit report</h1>

        <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]">
          <dt class="font-medium text-slate-600">URL</dt>
          <dd class="break-all" data-testid="audit-url">{result.target.url}</dd>

          <dt class="font-medium text-slate-600">Audited at</dt>
          <dd data-testid="audit-timestamp">
            <time datetime={result.startedAt}>{formatTimestamp(result.startedAt)}</time>
          </dd>

          <dt class="font-medium text-slate-600">Duration</dt>
          <dd>{formatDuration(result.durationMs)}</dd>
        </dl>

        {isSample && <SampleDataNotice />}
      </div>

      <SummaryStats summary={result.summary} />
      <EngineRuns engines={result.engines} />
      <FindingList findings={result.findings} />
    </main>

    <footer class="border-t border-slate-200 py-6 text-sm text-slate-600">
      <h2 class="font-semibold text-slate-800">What this report is not</h2>
      <p class="mt-2">
        Automated checks detect only a subset of accessibility barriers. This report does not
        establish WCAG conformance, and findings still need human review. Absence of findings is not
        evidence that a page is accessible.
      </p>
      <p class="mt-2">
        Each engine is used as a dependency and keeps its own license, listed beside it above.
      </p>
    </footer>
  </div>
</BaseLayout>
