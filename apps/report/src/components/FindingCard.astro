---
import type { AllyFinding } from '@ally/core';
import { CATEGORY_LABELS, strictestLevel } from '@ally/core';
import { formatCriteria, SEVERITY_BADGE, STANDARD_LABELS } from '../lib/format.js';

interface Props {
  finding: AllyFinding;
}

const { finding } = Astro.props;

const level = strictestLevel(finding.wcag);

// Some engines report a locator that *is* a path — Alfa and IBM both do — so
// showing both would print the same string twice.
const showSelector =
  finding.target?.selector !== undefined && finding.target.selector !== finding.target.path;

// Filter state travels on the element as data attributes, so the filtering
// script never needs a copy of the audit model.
const filterData = {
  'data-severity': finding.severity,
  'data-standard': finding.standard,
  'data-level': level ?? 'none',
  'data-engines': finding.engineIds.join(' '),
  'data-category': finding.category,
};
---

<li
  class="rounded-lg border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-900"
  data-finding
  {...filterData}
>
  <div class="px-4 py-3">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
      <span
        class={`rounded-full border px-2 py-0.5 text-xs font-semibold capitalize ${SEVERITY_BADGE[finding.severity]}`}
      >
        {finding.severity}
      </span>
      <h3 class="flex-1 text-base font-medium">{finding.title}</h3>
    </div>

    <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-600 dark:text-slate-400">
      <span>{CATEGORY_LABELS[finding.category]}</span>
      <span aria-hidden="true">·</span>
      <span>{STANDARD_LABELS[finding.standard]}</span>
      {
        finding.wcag.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>WCAG {formatCriteria(finding.wcag)}</span>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span class="font-mono">{finding.id}</span>
    </p>

    {
      finding.description && (
        <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">{finding.description}</p>
      )
    }

    {
      finding.target && (
        <div class="mt-3 rounded border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-950/60">
          <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">Affected element</p>
          {finding.target.label && (
            <p class="mt-1 text-sm">
              {finding.target.tagName && (
                <span class="font-mono text-xs">&lt;{finding.target.tagName}&gt;</span>
              )}
              <span class="ml-1">“{finding.target.label}”</span>
            </p>
          )}
          {finding.target.html &&
            /*
              Wrapping rather than scrolling. A horizontally scrollable region
              that cannot be reached with the keyboard is itself an
              accessibility bug — Ally's own axe check caught this one.

              `<pre>` preserves whitespace, including this file's indentation,
              so the tag and its content stay on one line.
            */
            // prettier-ignore
            <pre class="mt-1 font-mono text-xs break-all whitespace-pre-wrap"><code>{finding.target.html}</code></pre>}
          {showSelector && (
            <p class="mt-1 font-mono text-xs break-all text-slate-700 dark:text-slate-300">
              {finding.target.selector}
            </p>
          )}
          {finding.target.path && (
            <p class="mt-1 font-mono text-xs break-all text-slate-500 dark:text-slate-500">
              {finding.target.path}
            </p>
          )}
        </div>
      )
    }

    <div class="mt-3">
      <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">
        Detected by
        <span class="font-normal">
          — engine agreement {finding.engineAgreement}, deduplication confidence{' '}
          {finding.confidence === 'none' ? 'not applicable' : finding.confidence}
        </span>
      </p>
      <ul class="mt-1 flex flex-wrap gap-2" role="list" data-testid="detected-by">
        {
          finding.sources.map((source) => (
            <li class="rounded border border-slate-300 px-2 py-0.5 text-xs dark:border-slate-600">
              <span class="font-medium">{source.engineId}</span>
              <span class="text-slate-600 dark:text-slate-400"> · {source.ruleId}</span>
              {source.rawSeverity && (
                <span class="text-slate-500 dark:text-slate-500"> · {source.rawSeverity}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {
      (finding.evidence.length > 0 || finding.helpUrls.length > 0) && (
        <details class="mt-3">
          <summary class="inline-flex items-center gap-1 rounded text-sm font-medium text-slate-700 dark:text-slate-300">
            Evidence and documentation ({finding.evidence.length})
          </summary>

          {finding.evidence.length > 0 && (
            <ul class="mt-2 space-y-1" role="list">
              {finding.evidence.map((evidence) => (
                <li class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-950/60">
                  <span class="font-medium">{evidence.engineId}</span>
                  {evidence.code && (
                    <span class="text-slate-500 dark:text-slate-500"> ({evidence.code})</span>
                  )}
                  <span aria-hidden="true">: </span>
                  <span class="text-slate-700 dark:text-slate-300">{evidence.message}</span>
                </li>
              ))}
            </ul>
          )}

          {finding.helpUrls.length > 0 && (
            <ul class="mt-2 space-y-1" role="list">
              {finding.helpUrls.map((url) => (
                <li class="text-xs">
                  <a
                    class="underline decoration-slate-400 underline-offset-2 hover:decoration-current"
                    href={url}
                  >
                    {url}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </details>
      )
    }
  </div>
</li>
