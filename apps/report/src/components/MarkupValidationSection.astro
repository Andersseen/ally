---
import type { MarkupIssue, MarkupValidationResult } from '@ally/core';
import { formatDuration } from '../lib/format.js';

interface Props {
  validation: MarkupValidationResult;
}

const { validation } = Astro.props;

const issues =
  validation.status === 'ok'
    ? [...validation.errors, ...validation.warnings, ...validation.info]
    : [];
---

<section aria-labelledby="markup-heading">
  <h2 id="markup-heading" class="text-lg font-semibold">Markup validation</h2>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
    Separate diagnostic from Nu HTML Checker. These results are not included in the automated
    accessibility score.
  </p>

  {
    validation.status === 'failed' ? (
      <p class="mt-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100">
        Markup validation failed after {formatDuration(validation.durationMs)}:{' '}
        {validation.error.message}
      </p>
    ) : (
      <>
        <dl class="mt-3 grid grid-cols-3 gap-3 text-sm">
          <div class="rounded border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <dt class="text-slate-600 dark:text-slate-400">Errors</dt>
            <dd class="font-semibold tabular-nums">{validation.errors.length}</dd>
          </div>
          <div class="rounded border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <dt class="text-slate-600 dark:text-slate-400">Warnings</dt>
            <dd class="font-semibold tabular-nums">{validation.warnings.length}</dd>
          </div>
          <div class="rounded border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <dt class="text-slate-600 dark:text-slate-400">Duration</dt>
            <dd class="font-semibold tabular-nums">{formatDuration(validation.durationMs)}</dd>
          </div>
        </dl>

        {issues.length > 0 && (
          <ul class="mt-3 space-y-2" role="list">
            {issues.map((issue: MarkupIssue) => (
              <li class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class="font-semibold capitalize">{issue.severity}</span>
                  {(issue.line || issue.column) && (
                    <span class="text-xs text-slate-600 dark:text-slate-400">
                      line {issue.line ?? '?'} column {issue.column ?? '?'}
                    </span>
                  )}
                </div>
                <p class="mt-1">{issue.message}</p>
                {issue.extract && (
                  <pre class="mt-2 font-mono text-xs break-all whitespace-pre-wrap text-slate-700 dark:text-slate-300">
                    <code>{issue.extract}</code>
                  </pre>
                )}
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</section>
