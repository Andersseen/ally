---
import type { AuditResult } from '@ally/core';
import { SCORE_METHODOLOGY, SEVERITY_WEIGHTS, STANDARD_WEIGHTS } from '@ally/core';
import { STANDARD_LABELS } from '../lib/format.js';

interface Props {
  result: AuditResult;
}

const { result } = Astro.props;
const succeeded = result.engines.filter((run) => run.status === 'ok');
const failed = result.engines.filter((run) => run.status === 'failed');
---

{
  /*
  A number nobody can reconstruct is not evidence. This section exists so a
  reader can check Ally's arithmetic and see exactly what was and was not
  checked.
*/
}
<section aria-labelledby="methodology-heading" id="methodology">
  <h2 id="methodology-heading" class="text-lg font-semibold">Methodology</h2>

  <h3 class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-300">Engines that ran</h3>
  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" role="list">
    {
      succeeded.map((run) => (
        <li>
          {run.engine.name}
          {run.engine.version && <span class="font-mono text-xs"> v{run.engine.version}</span>}
          <span class="text-slate-600 dark:text-slate-400"> · {run.engine.license}</span>
        </li>
      ))
    }
    {
      failed.map((run) => (
        <li>{run.engine.name} — did not run, so this audit covers less than it was asked to</li>
      ))
    }
  </ul>

  <h3 class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-300">
    Deduplication (version {result.dedupeVersion})
  </h3>
  <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">
    Engines report the same problem in different words, so Ally merges findings that share a rule
    family, resolve to the same element, and make a compatible claim about WCAG. Merging is
    deterministic and conservative: a finding with no element locator is never merged, and findings
    whose success criteria do not overlap are kept separate. Every merged finding lists the engines
    that reported it and keeps each engine's own rule id, severity and message as evidence.
  </p>
  <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">
    A merge is labelled <strong>exact</strong> when the engines cited the same criteria and{' '}
    <strong>probable</strong> when their criteria only overlap. A false merge hides a real problem, while
    a missed merge only costs a duplicate row — so Ally errs towards leaving findings apart.
  </p>

  <h3 class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-300">
    {SCORE_METHODOLOGY.name} (version {result.score.version})
  </h3>
  <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">{SCORE_METHODOLOGY.summary}</p>
  <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm">
    {SCORE_METHODOLOGY.steps.map((step) => <li>{step}</li>)}
  </ol>

  <div class="mt-3 grid gap-4 sm:grid-cols-2">
    <div>
      <h4 class="text-xs font-semibold text-slate-600 uppercase dark:text-slate-400">
        Severity weights
      </h4>
      <dl class="mt-1 text-sm">
        {
          Object.entries(SEVERITY_WEIGHTS).map(([severity, weight]) => (
            <div class="flex justify-between border-b border-slate-200 py-0.5 dark:border-slate-800">
              <dt class="capitalize">{severity}</dt>
              <dd class="tabular-nums">{weight}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div>
      <h4 class="text-xs font-semibold text-slate-600 uppercase dark:text-slate-400">
        Classification multipliers
      </h4>
      <dl class="mt-1 text-sm">
        {
          Object.entries(STANDARD_WEIGHTS).map(([standard, weight]) => (
            <div class="flex justify-between border-b border-slate-200 py-0.5 dark:border-slate-800">
              <dt>{STANDARD_LABELS[standard as keyof typeof STANDARD_LABELS]}</dt>
              <dd class="tabular-nums">×{weight}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  {
    result.score.breakdown.length > 0 && (
      <>
        <h4 class="mt-4 text-xs font-semibold text-slate-600 uppercase dark:text-slate-400">
          This audit's penalty
        </h4>
        {/*
          No scroll container. A horizontally scrollable region has to be
          focusable or its content is unreachable by keyboard, and these five
          short columns wrap perfectly well instead.
        */}
        <div class="mt-1">
          <table class="w-full text-left text-sm">
            <caption class="sr-only">
              Penalty contributed by each severity and classification
            </caption>
            <thead>
              <tr class="border-b border-slate-300 dark:border-slate-700">
                <th scope="col" class="py-1 pr-4 font-semibold">
                  Severity
                </th>
                <th scope="col" class="py-1 pr-4 font-semibold">
                  Classification
                </th>
                <th scope="col" class="py-1 pr-4 text-right font-semibold">
                  Groups
                </th>
                <th scope="col" class="py-1 pr-4 text-right font-semibold">
                  Findings
                </th>
                <th scope="col" class="py-1 text-right font-semibold">
                  Penalty
                </th>
              </tr>
            </thead>
            <tbody>
              {result.score.breakdown.map((entry) => (
                <tr class="border-b border-slate-200 dark:border-slate-800">
                  <td class="py-1 pr-4 capitalize">{entry.severity}</td>
                  <td class="py-1 pr-4">{STANDARD_LABELS[entry.standard]}</td>
                  <td class="py-1 pr-4 text-right tabular-nums">{entry.groups}</td>
                  <td class="py-1 pr-4 text-right tabular-nums">{entry.findings}</td>
                  <td class="py-1 text-right tabular-nums">{entry.penalty}</td>
                </tr>
              ))}
              <tr class="font-semibold">
                <td class="py-1 pr-4" colspan={4}>
                  Total penalty
                </td>
                <td class="py-1 text-right tabular-nums">{result.score.penalty}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <h3 class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-300">
    What the keyboard analysis checks
  </h3>
  <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">
    It determines the expected sequential focus order with <code class="font-mono">tabbable</code>,
    then presses Tab and Shift+Tab in Chromium and records where focus lands. It reports positive
    tabindex values, tabbable elements the traversal never reached, stops nothing predicted, focus
    landing on the document body, and repeating focus cycles. It does not press Enter, Space or
    Escape, does not click anything, and does not open or interact with dialogs — so it cannot yet
    tell a deliberate modal focus trap from a broken one.
  </p>

  <h3 class="mt-4 text-sm font-semibold text-slate-700 dark:text-slate-300">
    Limits of automated testing
  </h3>
  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" role="list">
    {SCORE_METHODOLOGY.limits.map((limit) => <li>{limit}</li>)}
    <li>
      Findings that need human judgement — axe's <em>incomplete</em>, IBM's <em>potential</em>,
      Alfa's <em>cantTell</em> and QualWeb's <em>warning</em> — are recorded in the raw output but are
      not reported as failures.
    </li>
    <li>
      Only one page in one viewport was tested, with no authentication and no interaction beyond
      keyboard navigation.
    </li>
  </ul>
  <p
    class="mt-3 border-l-4 border-slate-400 pl-3 text-sm text-slate-700 dark:border-slate-600 dark:text-slate-300"
  >
    Manual accessibility review is still required. Nothing in this report — including a score of 100
    — establishes WCAG conformance.
  </p>
</section>
