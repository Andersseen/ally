---
import type { NormalizedFinding } from '@ally/core';
import { compareSeverity } from '@ally/core';

interface Props {
  findings: readonly NormalizedFinding[];
  /** How many findings to render. The full list lives in audit.json. */
  limit?: number;
}

const { findings, limit = 10 } = Astro.props;

// Ordering by domain severity rather than by engine output order.
const ordered = [...findings].sort((a, b) => compareSeverity(a.severity, b.severity));
const shown = ordered.slice(0, limit);

const SEVERITY_BADGE: Record<NormalizedFinding['severity'], string> = {
  critical: 'border-red-300 bg-red-100 text-red-950',
  serious: 'border-orange-300 bg-orange-100 text-orange-950',
  moderate: 'border-yellow-300 bg-yellow-100 text-yellow-950',
  minor: 'border-slate-300 bg-slate-100 text-slate-900',
};
---

<section aria-labelledby="findings-heading">
  <h2 id="findings-heading" class="text-lg font-semibold">Findings</h2>

  {
    shown.length === 0 ? (
      <p class="mt-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-slate-700">
        No findings were reported. Automated checks cover only part of accessibility — manual review
        is still required.
      </p>
    ) : (
      <ul class="mt-3 space-y-3" role="list">
        {shown.map((finding) => (
          <li class="rounded-lg border border-slate-200 bg-white px-4 py-3">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span
                class={`rounded-full border px-2 py-0.5 text-xs font-medium capitalize ${SEVERITY_BADGE[finding.severity]}`}
              >
                {finding.severity}
              </span>
              <h3 class="font-medium">{finding.title}</h3>
            </div>

            {finding.description && (
              <p class="mt-2 text-sm text-slate-700">{finding.description}</p>
            )}

            <p class="mt-2 text-xs text-slate-600">
              <span>
                Reported by <span class="font-medium">{finding.engineId}</span>
              </span>
              <span aria-hidden="true"> · </span>
              <span>
                Rule <code class="font-mono">{finding.ruleId}</code>
              </span>
              {finding.wcag.length > 0 && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span>
                    WCAG{' '}
                    {finding.wcag
                      .map((criterion) =>
                        criterion.level === undefined
                          ? criterion.id
                          : `${criterion.id} (${criterion.level})`,
                      )
                      .join(', ')}
                  </span>
                </>
              )}
            </p>

            {finding.evidence.length > 0 && (
              <details class="mt-2">
                <summary class="cursor-pointer text-sm text-slate-700">
                  Evidence ({finding.evidence.length})
                </summary>
                <ul class="mt-2 space-y-2" role="list">
                  {finding.evidence.map((evidence) => (
                    <li class="rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                      {evidence.selector && (
                        <p class="font-mono break-all text-slate-800">{evidence.selector}</p>
                      )}
                      {evidence.html && (
                        <pre class="mt-1 overflow-x-auto font-mono text-slate-600">
                          <code>{evidence.html}</code>
                        </pre>
                      )}
                      {evidence.message && <p class="mt-1 text-slate-700">{evidence.message}</p>}
                    </li>
                  ))}
                </ul>
              </details>
            )}

            {finding.helpUrl && (
              <p class="mt-2 text-xs">
                <a
                  class="underline decoration-slate-400 underline-offset-2 hover:decoration-slate-900"
                  href={finding.helpUrl}
                >
                  Rule documentation
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    ordered.length > shown.length && (
      <p class="mt-3 text-sm text-slate-600">
        Showing {shown.length} of {ordered.length} findings. The complete set is in{' '}
        <code class="font-mono">audit.json</code>.
      </p>
    )
  }
</section>
