---
import type { AuditSummary } from '@ally/core';
import { SEVERITIES } from '@ally/core';

interface Props {
  summary: AuditSummary;
}

const { summary } = Astro.props;

const SEVERITY_STYLES: Record<(typeof SEVERITIES)[number], string> = {
  critical: 'border-red-300 bg-red-50 text-red-950',
  serious: 'border-orange-300 bg-orange-50 text-orange-950',
  moderate: 'border-yellow-300 bg-yellow-50 text-yellow-950',
  minor: 'border-slate-300 bg-slate-100 text-slate-900',
};
---

<section aria-labelledby="summary-heading">
  <h2 id="summary-heading" class="text-lg font-semibold">Summary</h2>

  <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
      <dt class="text-sm text-slate-600">Total findings</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="total-findings">
        {summary.totalFindings}
      </dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
      <dt class="text-sm text-slate-600">Unique findings</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="unique-findings">
        {
          summary.uniqueFindings ?? (
            <span class="text-base font-normal text-slate-500">
              Not yet computed
              <span class="sr-only">— cross-engine deduplication is not implemented</span>
            </span>
          )
        }
      </dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
      <dt class="text-sm text-slate-600">Engines succeeded</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums">{summary.enginesSucceeded}</dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
      <dt class="text-sm text-slate-600">Engines failed</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums">{summary.enginesFailed}</dd>
    </div>
  </dl>

  <h3 class="mt-6 text-sm font-semibold text-slate-700">Findings by severity</h3>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      SEVERITIES.map((severity) => (
        <div class={`rounded-lg border px-4 py-3 ${SEVERITY_STYLES[severity]}`}>
          <dt class="text-sm capitalize">{severity}</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{summary.bySeverity[severity]}</dd>
        </div>
      ))
    }
  </dl>
</section>
