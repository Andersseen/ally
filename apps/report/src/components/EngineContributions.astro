---
import type { AuditResult } from '@ally/core';
import { formatDuration } from '../lib/format.js';

interface Props {
  engines: AuditResult['engines'];
  contributions: AuditResult['contributions'];
}

const { engines, contributions } = Astro.props;

const byId = new Map(contributions.map((contribution) => [contribution.engineId, contribution]));
---

{
  /*
  Engines are shown individually because Ally's premise — that several engines
  are worth running — is a claim this table can support or undermine. Failures
  are stated in words rather than by colour alone.
*/
}
<section aria-labelledby="engines-heading">
  <h2 id="engines-heading" class="text-lg font-semibold">Engines</h2>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
    “Unique” means no other engine reported the same problem on the same element.
  </p>

  <ul class="mt-3 space-y-2" role="list">
    {
      engines.map((run) => {
        const contribution = byId.get(run.engine.id);

        return (
          <li
            class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"
            data-testid={`engine-${run.engine.id}`}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-medium">
                <a
                  class="underline decoration-slate-400 underline-offset-2 hover:decoration-current"
                  href={run.engine.homepage}
                >
                  {run.engine.name}
                </a>
                {run.engine.version && (
                  <span class="ml-2 font-mono text-xs font-normal text-slate-600 dark:text-slate-400">
                    v{run.engine.version}
                  </span>
                )}
              </h3>

              <p class="text-sm text-slate-600 dark:text-slate-400">
                {run.status === 'ok' ? (
                  <span>Completed</span>
                ) : (
                  <span class="font-semibold text-red-800 dark:text-red-300">Failed</span>
                )}
                <span aria-hidden="true"> · </span>
                <span>{formatDuration(run.durationMs)}</span>
              </p>
            </div>

            {run.status === 'ok' ? (
              <dl class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-4">
                <div>
                  <dt class="text-slate-600 dark:text-slate-400">Raw</dt>
                  <dd class="font-medium tabular-nums">{run.rawFindingCount}</dd>
                </div>
                <div>
                  <dt class="text-slate-600 dark:text-slate-400">Normalized</dt>
                  <dd class="font-medium tabular-nums">{run.findingCount}</dd>
                </div>
                <div>
                  <dt class="text-slate-600 dark:text-slate-400">Unique</dt>
                  <dd class="font-medium tabular-nums">{contribution?.uniqueContributions ?? 0}</dd>
                </div>
                <div>
                  <dt class="text-slate-600 dark:text-slate-400">Shared</dt>
                  <dd class="font-medium tabular-nums">{contribution?.sharedContributions ?? 0}</dd>
                </div>
              </dl>
            ) : (
              <p class="mt-2 rounded border border-red-300 bg-red-50 px-3 py-2 font-mono text-sm break-words text-red-950 dark:border-red-500/50 dark:bg-red-950/40 dark:text-red-100">
                {run.error.message}
              </p>
            )}

            <p class="mt-2 text-xs text-slate-500 dark:text-slate-500">
              Licensed under {run.engine.license}
            </p>
          </li>
        );
      })
    }
  </ul>
</section>
