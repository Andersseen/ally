---
import type { AuditResult } from '@ally/core';
import { SEVERITIES } from '@ally/core';
import { SEVERITY_BADGE, STANDARD_LABELS } from '../lib/format.js';

interface Props {
  result: AuditResult;
}

const { result } = Astro.props;
const { summary, coverage, keyboard } = result;

const keyboardStops = keyboard?.status === 'ok' ? keyboard.forward.stops.length : undefined;
const keyboardExpected = keyboard?.status === 'ok' ? keyboard.expected.length : undefined;
const keyboardWarnings = keyboard?.status === 'ok' ? keyboard.anomalies.length : undefined;
---

<section aria-labelledby="overview-heading">
  <h2 id="overview-heading" class="text-lg font-semibold">Overview</h2>

  <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div
      class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"
    >
      <dt class="text-sm text-slate-600 dark:text-slate-400">Engines run</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="engines-run">
        {coverage.enginesSucceeded}/{coverage.enginesConfigured}
      </dd>
    </div>
    <div
      class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"
    >
      <dt class="text-sm text-slate-600 dark:text-slate-400">Raw findings</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="total-findings">
        {summary.totalFindings}
      </dd>
    </div>
    <div
      class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"
    >
      <dt class="text-sm text-slate-600 dark:text-slate-400">Unique findings</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="unique-findings">
        {summary.uniqueFindings}
      </dd>
    </div>
    <div
      class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"
    >
      <dt class="text-sm text-slate-600 dark:text-slate-400">Engines failed</dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="engines-failed">
        {summary.enginesFailed}
      </dd>
    </div>
  </dl>

  <h3 class="mt-6 text-sm font-semibold text-slate-700 dark:text-slate-300">
    Unique findings by severity
  </h3>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-5">
    {
      SEVERITIES.map((severity) => (
        <div class={`rounded-lg border px-4 py-3 ${SEVERITY_BADGE[severity]}`}>
          <dt class="text-sm capitalize">{severity}</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid={`severity-${severity}`}>
            {summary.bySeverity[severity]}
          </dd>
        </div>
      ))
    }
  </dl>

  <h3 class="mt-6 text-sm font-semibold text-slate-700 dark:text-slate-300">
    Unique findings by classification
  </h3>
  <dl class="mt-2 grid grid-cols-3 gap-3">
    {
      (['wcag', 'best-practice', 'unknown'] as const).map((standard) => (
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">{STANDARD_LABELS[standard]}</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{summary.byStandard[standard]}</dd>
        </div>
      ))
    }
  </dl>

  {
    keyboard !== undefined && (
      <>
        <h3 class="mt-6 text-sm font-semibold text-slate-700 dark:text-slate-300">
          Keyboard analysis
        </h3>
        {keyboard.status === 'ok' ? (
          <dl class="mt-2 grid grid-cols-3 gap-3">
            <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Tabbable elements</dt>
              <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="keyboard-expected">
                {keyboardExpected}
              </dd>
            </div>
            <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Observed tab stops</dt>
              <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="keyboard-observed">
                {keyboardStops}
              </dd>
            </div>
            <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Warnings</dt>
              <dd class="mt-1 text-2xl font-semibold tabular-nums" data-testid="keyboard-warnings">
                {keyboardWarnings}
              </dd>
            </div>
          </dl>
        ) : (
          <p class="mt-2 rounded-lg border border-red-400 bg-red-50 px-4 py-3 text-sm text-red-950 dark:border-red-500/60 dark:bg-red-950/40 dark:text-red-100">
            The keyboard analysis failed, so no keyboard evidence was collected:{' '}
            {keyboard.error.message}
          </p>
        )}
      </>
    )
  }
</section>
