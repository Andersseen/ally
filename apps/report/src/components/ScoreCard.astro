---
import type { AutomatedScore } from '@ally/core';

interface Props {
  score: AutomatedScore;
}

const { score } = Astro.props;
---

{
  /*
  The score and its disclaimer are one component on purpose: the number must
  never appear anywhere without the sentence that says what it is not.
*/
}
<section
  aria-labelledby="score-heading"
  class="rounded-xl border border-slate-300 bg-white p-5 sm:p-6 dark:border-slate-700 dark:bg-slate-900"
>
  <h2
    id="score-heading"
    class="text-sm font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400"
  >
    Automated Accessibility Score
  </h2>

  <p class="mt-2 flex items-baseline gap-2">
    <span class="text-5xl font-bold tabular-nums" data-testid="score-value">{score.value}</span>
    <span class="text-xl text-slate-600 dark:text-slate-400">/ 100</span>
  </p>

  <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
    Methodology version {score.version} · {score.groupCount} problem groups · penalty {
      score.penalty
    }
  </p>

  <p
    class="mt-4 border-l-4 border-slate-400 pl-3 text-sm text-slate-700 dark:border-slate-600 dark:text-slate-300"
    data-testid="score-disclaimer"
  >
    This score represents automated testing results only. It does not establish WCAG conformance and
    does not replace manual accessibility review.
  </p>

  <p class="mt-3 text-sm">
    <a
      class="underline decoration-slate-400 underline-offset-2 hover:decoration-current"
      href="#methodology">How this score is calculated</a
    >
  </p>
</section>
