---
import type { AuditResult } from '@ally/core';

interface Props {
  result: AuditResult;
}

const { result } = Astro.props;
const review = result.wcagReview;
const ai = result.aiReview;
const criteria = review?.criteria ?? [];
const automated = criteria.filter((criterion) =>
  criterion.statuses.includes('automated-checked'),
).length;
const behavioral = criteria.filter((criterion) =>
  criterion.statuses.includes('behaviorally-checked'),
).length;
const covered = criteria.filter(
  (criterion) =>
    criterion.statuses.includes('automated-checked') ||
    criterion.statuses.includes('behaviorally-checked') ||
    criterion.statuses.includes('ai-reviewed'),
).length;
const coveragePercent = criteria.length === 0 ? 0 : Math.round((covered / criteria.length) * 100);
const manual = criteria.filter((criterion) => criterion.manualReviewRequired).length;
const aiReviewed = ai?.reviews.filter((item) => item.status === 'reviewed').length ?? 0;
const rows = criteria
  .filter(
    (criterion) =>
      criterion.automatedFindingCount > 0 ||
      criterion.aiReviewCount > 0 ||
      criterion.statuses.includes('not-yet-covered'),
  )
  .slice(0, 12);
const flagged =
  ai?.reviews.filter(
    (item) => item.status === 'reviewed' && item.result?.outcome === 'potential-issue',
  ) ?? [];
---

{
  review && (
    <section aria-labelledby="wcag-review-heading">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="wcag-review-heading" class="text-lg font-semibold">
            WCAG 2.2 A/AA Review
          </h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
            Dataset {review.standard.datasetRevision}
          </p>
        </div>
        <span class="rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold uppercase dark:border-slate-700">
          AI {ai?.status ?? 'disabled'}
        </span>
      </div>

      <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">Review coverage</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">
            {coveragePercent}%
            <span class="text-sm font-normal text-slate-500">
              ({covered}/{criteria.length})
            </span>
          </dd>
        </div>
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">Automatically checked</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{automated}</dd>
        </div>
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">Behaviorally checked</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{behavioral}</dd>
        </div>
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">AI-assisted review</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{aiReviewed}</dd>
        </div>
        <div class="rounded-lg border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
          <dt class="text-sm text-slate-600 dark:text-slate-400">Manual review required</dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums">{manual}</dd>
        </div>
      </dl>

      {ai?.status === 'unavailable' && (
        <p class="mt-3 rounded-lg border border-amber-400 bg-amber-50 px-4 py-3 text-sm text-amber-950 dark:border-amber-500/60 dark:bg-amber-950/40 dark:text-amber-100">
          AI-assisted review unavailable. Deterministic audit results are still complete.
        </p>
      )}

      <div class="mt-3 rounded-lg border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-900">
        <ul role="list" class="divide-y divide-slate-200 dark:divide-slate-800">
          {rows.map((criterion) => (
            <li class="px-4 py-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-sm font-semibold">
                  {criterion.criterion.id} {criterion.criterion.title}
                  <span class="text-slate-500"> Level {criterion.criterion.level}</span>
                </h3>
                <span class="rounded-full border border-slate-300 px-2 py-0.5 text-xs dark:border-slate-700">
                  {criterion.statuses[0]}
                </span>
              </div>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                Automated evidence {criterion.automatedFindingCount} · AI reviews{' '}
                {criterion.aiReviewCount} · Human review{' '}
                {criterion.manualReviewRequired ? 'recommended' : 'not expected'}
              </p>
            </li>
          ))}
        </ul>
      </div>

      {flagged.length > 0 && (
        <div class="mt-3 space-y-3">
          {flagged.map((item) => (
            <article class="rounded-lg border border-amber-400 bg-amber-50 px-4 py-3 dark:border-amber-500/60 dark:bg-amber-950/40">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-amber-200 px-2 py-0.5 text-xs font-semibold text-amber-950">
                  {item.result?.outcome}
                </span>
                <span class="text-xs font-semibold uppercase text-slate-600 dark:text-slate-400">
                  Confidence {item.result?.confidence}
                </span>
              </div>
              <h3 class="mt-2 text-sm font-semibold">
                {item.task.criterion} {item.task.rule.title}
              </h3>
              <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{item.result?.summary}</p>
              {item.result?.suggestedReview && (
                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">
                  {item.result.suggestedReview}
                </p>
              )}
            </article>
          ))}
        </div>
      )}
    </section>
  )
}
