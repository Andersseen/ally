---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Automated accessibility audit results. Automated testing only; not a conformance claim."
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <a
      href="#main"
      class="sr-only rounded-md bg-slate-900 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3 dark:bg-slate-100 dark:text-slate-900"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
