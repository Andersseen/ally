# Copy to .env for local runs against a real Cloudflare account (not needed
# for `pnpm dev` — that uses apps/worker/src/local-dev.ts instead, which runs
# the same @ally/runner-core execution path in-process with no queue).
# .env is gitignored; do not commit real values.

# Origin of the deployed Ally Worker. No trailing slash.
ALLY_WORKER_BASE_URL=https://ally.andersseen.dev

# Bearer secret for the Worker's /api/runner/* surface. Must match the
# Worker's ALLY_RUNNER_SECRET (wrangler secret put ALLY_RUNNER_SECRET).
ALLY_RUNNER_SECRET=replace-with-runner-secret

# Cloudflare account id, and an API token scoped to Queues pull/ack on the
# ally-audit-jobs queue only — not a general-purpose account token.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_QUEUES_API_TOKEN=replace-with-scoped-queues-token

# The queue's id (not its name) — from `wrangler queues list`.
CLOUDFLARE_QUEUE_ID=replace-with-queue-id

# Optional. Identifies this process in logs and runner_id columns; a random
# id is generated when unset.
# ALLY_RUNNER_ID=runner-1

# Optional budgets, all in milliseconds (defaults shown).
# ALLY_NAVIGATION_TIMEOUT_MS=30000
# ALLY_AUDIT_TIMEOUT_MS=120000
# ALLY_MAX_REDIRECTS=5

# Optional queue polling/lease tuning.
# ALLY_QUEUE_POLL_INTERVAL_MS=2000
# ALLY_QUEUE_VISIBILITY_TIMEOUT_MS=150000

# Optional. Port for the /healthz endpoint.
# ALLY_HEALTH_PORT=8080
