{
  "name": "@ally/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker API and audit consumer for Ally hosted audits",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @ally/cli... build && node --experimental-strip-types src/local-dev.ts",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "clean": "rm -rf .turbo .wrangler"
  },
  "dependencies": {
    "@ally/audit-runner": "workspace:*",
    "@ally/browser": "workspace:*",
    "@ally/core": "workspace:*",
    "@ally/reporter-json": "workspace:*",
    "@cloudflare/playwright": "catalog:"
  },
  "devDependencies": {
    "@ally/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
