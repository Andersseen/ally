---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const apiBase = import.meta.env.PUBLIC_ALLY_API_BASE ?? 'http://127.0.0.1:8787';
---

<BaseLayout title="Ally report">
  <main class="shell" and-layout="vertical gap:xl">
    <header class="topbar" and-layout="horizontal align:center justify:between gap:md wrap:wrap">
      <a class="brand-mark" href="/">
        <span class="brand-icon" aria-hidden="true">
          <and-icon name="accessibility" size="20"></and-icon>
        </span>
        <span>Ally</span>
      </a>
      <div and-layout="horizontal align:center gap:sm wrap:wrap">
        <and-button href="/dashboard" variant="outline" size="sm">
          <and-icon name="arrow-right" size="15"></and-icon>
          New audit
        </and-button>
        <ThemeToggle />
      </div>
    </header>

    <section id="report" class="py-8" data-api-base={apiBase} aria-live="polite">
      <and-card padded="true">
        <div and-layout="horizontal align:center gap:sm">
          <and-icon name="loader" size="18"></and-icon>
          <p class="text-ally-muted">Loading report...</p>
        </div>
      </and-card>
    </section>
  </main>

  <script src="../scripts/report.ts"></script>
</BaseLayout>
