---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const apiBase = import.meta.env.PUBLIC_ALLY_API_BASE ?? 'http://127.0.0.1:8787';
---

<BaseLayout title="Dashboard">
  <main class="shell" and-layout="vertical gap:xl">
    <header class="topbar" and-layout="horizontal align:center justify:between gap:md wrap:wrap">
      <a class="brand-mark" href="/">
        <span class="brand-icon" aria-hidden="true">
          <img class="brand-logo" src="/logo.svg" alt="" width="28" height="28" />
        </span>
        <span>Ally</span>
      </a>
      <div and-layout="horizontal align:center gap:sm wrap:wrap">
        <and-badge variant="secondary">Automated audit MVP</and-badge>
        <ThemeToggle />
      </div>
    </header>

    <section class="grid flex-1 items-center gap-8 py-10 md:grid-cols-[1.04fr_0.96fr]">
      <div and-layout="vertical gap:lg" and-motion="fade-in-up" and-motion-trigger="enter">
        <p class="eyebrow">Hosted web audit</p>
        <h1 class="hero-title">Ally</h1>
        <p class="hero-copy">
          Run axe-core, IBM Equal Access, Siteimprove Alfa, QualWeb, HTML_CodeSniffer, and Ally's
          keyboard analyzer against one public page, then normalize, deduplicate, and score the
          findings.
        </p>
        <div and-layout="horizontal gap:sm wrap:wrap">
          <and-badge variant="outline">
            <and-icon name="activity" size="14"></and-icon>
            5 engines
          </and-badge>
          <and-badge variant="outline">
            <and-icon name="file-text" size="14"></and-icon>
            JSON report
          </and-badge>
          <and-badge variant="outline">
            <and-icon name="success" size="14"></and-icon>
            Normalized findings
          </and-badge>
        </div>
        <and-alert variant="default">
          <and-icon slot="icon" name="info"></and-icon>
          Automated auditing does not prove WCAG conformance. A clean automated result still requires
          manual review before you can claim accessibility.
        </and-alert>
      </div>

      <form
        id="audit-form"
        class="surface audit-card p-5"
        data-api-base={apiBase}
        and-layout="vertical gap:md"
      >
        <and-card id="target-panel" padded="true" data-locked="true" aria-disabled="true">
          <div and-layout="vertical gap:md">
            <div and-layout="horizontal align:center justify:between gap:sm">
              <div>
                <p class="eyebrow">Target</p>
                <h2 class="text-ally-ink mt-1 text-xl font-bold">Public URL</h2>
              </div>
              <span class="brand-icon" aria-hidden="true">
                <and-icon name="play" size="18"></and-icon>
              </span>
            </div>

            <label class="text-ally-ink text-sm font-semibold" for="audit-url"> Public URL </label>
            <p id="audit-lock-message" class="text-ally-muted text-sm">
              Sign in to unlock hosted audits.
            </p>
            <input
              id="audit-url"
              name="url"
              type="url"
              inputmode="url"
              autocomplete="url"
              required
              disabled
              placeholder="https://example.com"
              class="native-field"
            />
            <fieldset class="space-y-2">
              <legend class="text-ally-ink text-sm font-semibold">Audit options</legend>
              <label class="flex items-center gap-2 text-sm">
                <input id="option-keyboard" type="checkbox" checked class="size-4" />
                <span>Keyboard analysis</span>
              </label>
              <label class="flex items-center gap-2 text-sm">
                <input id="option-recommendations" type="checkbox" class="size-4" />
                <span>Recommendations</span>
              </label>
              <label class="flex items-center gap-2 text-sm">
                <input id="option-markup" type="checkbox" class="size-4" />
                <span>Markup validation</span>
              </label>
            </fieldset>
            <and-button id="run-button" class="full-width" type="submit" size="lg" disabled>
              <and-icon name="arrow-right" size="18"></and-icon>
              Run audit
            </and-button>
          </div>
        </and-card>

        <and-card id="status-panel" class="hidden" padded="true">
          <div class="flex items-start gap-3" role="status" aria-live="polite" aria-atomic="true">
            <span
              id="status-icon"
              class="status-dot mt-0.5"
              data-status-icon="queued"
              aria-hidden="true"
            >
              <and-icon name="loader" size="15"></and-icon>
            </span>
            <div>
              <h2 id="status-title" class="text-ally-ink text-base font-semibold">
                Preparing audit
              </h2>
              <p id="status-message" class="text-ally-muted mt-1 text-sm"></p>
              <p id="stage-message" class="text-ally-muted mt-1 text-xs"></p>
            </div>
          </div>
          <and-button id="stop-button" class="mt-4 hidden" type="button" variant="ghost">
            <and-icon name="close" size="16"></and-icon>
            Stop audit
          </and-button>
          <and-button id="report-link" class="mt-4 hidden" href="/reports" variant="outline">
            <and-icon name="external-link" size="16"></and-icon>
            View report
          </and-button>
        </and-card>
      </form>
    </section>

    <section class="pb-10" and-layout="vertical gap:md">
      <h2 class="text-ally-ink text-xl font-bold">Recent audits</h2>
      <and-card id="recent-audits-empty" padded="true">
        <p class="text-ally-muted text-sm">No audits yet. Run one above.</p>
      </and-card>
      <ul id="recent-audits-list" class="hidden space-y-3" role="list"></ul>
    </section>
  </main>

  <script src="../scripts/home.ts"></script>
</BaseLayout>
