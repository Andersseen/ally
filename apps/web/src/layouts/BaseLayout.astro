---
import '../styles/tailwind.css';
import '../styles/global.scss';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" and-theme="compact" and-color="rose-teal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Run an automated Ally accessibility audit against a public URL."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
