{
  "name": "ally",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An experimental open-source accessibility audit orchestrator",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "pnpm build && pnpm run e2e:prepare && pnpm --filter @ally/report test:e2e",
    "e2e:prepare": "node scripts/prepare-e2e.ts",
    "typecheck": "turbo run build typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "ally": "node scripts/ally.ts",
    "build:web:production": "PUBLIC_SITE_URL=https://ally.andersseen.dev PUBLIC_ALLY_API_BASE=https://ally.andersseen.dev pnpm --filter @ally/web build",
    "pages:create": "pnpm --dir apps/worker exec wrangler pages project create ally-audit-web --production-branch main",
    "deploy:web": "pnpm run build:web:production && pnpm --dir apps/worker exec wrangler pages deploy ../web/dist --project-name ally-audit-web --branch main --commit-dirty=true",
    "deploy:worker:dry-run": "pnpm --filter @ally/worker run deploy:dry-run",
    "e2e:install": "playwright install chromium",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo"
  },
  "devDependencies": {
    "@ally/analyzer-keyboard": "workspace:*",
    "@ally/audit-runner": "workspace:*",
    "@ally/browser": "workspace:*",
    "@ally/cli": "workspace:*",
    "@ally/config": "workspace:*",
    "@ally/core": "workspace:*",
    "@ally/fixtures": "workspace:*",
    "@ally/reporter-json": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
